<?xml version="1.0" encoding="UTF-8"?>

<?import com.johnie.pixelbead.ui.components.InteractiveCanvas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml" fx:controller="com.johnie.pixelbead.ui.MainController"
            prefWidth="1280" prefHeight="800">
    <top>
        <ToolBar>
            <Button fx:id="importButton" text="Import Image" onAction="#onImportImage"/>
            <Button fx:id="autoButton" text="Auto" onAction="#onAutoSettings"/>
            <Separator/>
            <ComboBox fx:id="formatCombo" prefWidth="90"/>
            <Button fx:id="exportButton" text="Export" onAction="#onExport" disable="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Fit View" onAction="#onFitView"/>
            <ToggleButton fx:id="previewButton" text="Preview" onAction="#onTogglePreview"/>
            <Button fx:id="themeButton" text="Dark" onAction="#onToggleTheme"/>
        </ToolBar>
    </top>
    <left>
        <fx:include fx:id="leftPanel" source="left-panel.fxml"/>
    </left>
    <right>
        <VBox styleClass="side-panel" spacing="8" prefWidth="250">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
            <fx:include fx:id="palettePanel" source="palette-panel.fxml"/>
            <fx:include fx:id="countPanel" source="count-panel.fxml"/>
        </VBox>
    </right>
    <bottom>
        <HBox styleClass="status-bar" spacing="16">
            <padding>
                <Insets top="6" right="12" bottom="6" left="12"/>
            </padding>
            <Label fx:id="hoverLabel" text=""/>
            <Label fx:id="statusLabel" styleClass="status-hint" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="boardSizeLabel" text=""/>
        </HBox>
    </bottom>
    <center>
        <StackPane>
            <InteractiveCanvas fx:id="canvas"/>
            <StackPane fx:id="loadingOverlay" styleClass="loading-overlay" visible="false" managed="false">
                <VBox alignment="CENTER" spacing="12">
                    <ProgressIndicator/>
                    <Label text="Converting..."/>
                </VBox>
            </StackPane>
        </StackPane>
    </center>
</BorderPane>
